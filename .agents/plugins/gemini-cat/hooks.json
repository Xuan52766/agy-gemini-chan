{
  "gemini-cat": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ../../../hooks/session-start.mjs",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ../../../hooks/pre-invocation.mjs",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node ../../../hooks/post-tool-use.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ../../../hooks/stop.mjs",
        "timeout": 15
      }
    ]
  }
}
